# Copy to .env; never commit credentials. Run commands from backend/.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATASET_DIR=../..
# anthropic or openai-compatible (e.g. Groq). Set an exact model supported by your provider.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.anthropic.com/v1
# For Groq GPT-OSS: LLM_PROVIDER=openai-compatible,
# LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_THRESHOLD=0.35
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGIN=http://localhost:5173

# Automatic NVIDIA fallback; add your key and restart the backend.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
# Optional larger fallback: NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_TIMEOUT_SECONDS=30
LLM_FALLBACK_COOLDOWN_SECONDS=300
